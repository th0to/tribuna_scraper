# Configuration du Spider Tribuna (POST direct, sans Playwright)

# URL de base du site à scraper
BASE_URL=https://publicationtc.fr.ch/

# Canton à scraper (fribourg, graubunden, etc.)
CANTON=fribourg

# Date de début pour scraping incrémental (format YYYY-MM-DD, vide = scraping complet)
START_DATE=

# Délai entre les requêtes (en secondes) - Client utilise 0.75-1s
DOWNLOAD_DELAY=1

# Nombre de requêtes concurrentes (1 recommandé pour Tribuna)
CONCURRENT_REQUESTS=1

# Timeout pour les sélecteurs Playwright (en millisecondes) - NON UTILISÉ (POST direct)
SELECTOR_TIMEOUT=10000

# Timeout de téléchargement (en secondes)
DOWNLOAD_TIMEOUT=60

# Nombre maximum de pages à scraper (0 = illimité)
MAX_PAGES=0

# Niveau de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Dossier de sortie pour les résultats
OUTPUT_DIR=./output

# Format de sortie (json, csv, both)
OUTPUT_FORMAT=json

# Activer le cache HTTP (true/false)
CACHE_ENABLED=false

# User-Agent personnalisé
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# Retry settings
RETRY_TIMES=3

# AutoThrottle (adaptation automatique du delay)
AUTOTHROTTLE_ENABLED=false
AUTOTHROTTLE_START_DELAY=1
AUTOTHROTTLE_MAX_DELAY=10
AUTOTHROTTLE_TARGET_CONCURRENCY=1.0
