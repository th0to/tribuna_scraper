import scrapy
from scrapy_playwright.page import PageMethod
import json
import re
import os
from dotenv import load_dotenv
from pathlib import Path
from publication_scraper.items import PublicationItem

# Charger les variables d'environnement
env_path = Path(__file__).parent.parent.parent / '.env'
load_dotenv(dotenv_path=env_path)


class PublicationSpider(scrapy.Spider):
    """
    Spider pour extraire les publications de https://publicationtc.fr.ch/
    
    Ce spider effectue les opérations suivantes :
    1. Recherche avec le terme 'e'
    2. Extrait les données de chaque ligne du tableau (date publication, date arrêt, lien PDF)
    3. Navigue vers les pages suivantes
    """
    name = 'publication_spider'
    allowed_domains = ['publicationtc.fr.ch']
    
    # Variables d'environnement
    search_term = os.getenv('SEARCH_TERM', 'e')
    base_url = os.getenv('BASE_URL', 'https://publicationtc.fr.ch/')
    max_pages = int(os.getenv('MAX_PAGES', 0))
    selector_timeout = int(os.getenv('SELECTOR_TIMEOUT', 10000))
    
    start_urls = [base_url]
    
    # Compteur de pages
    current_page = 1
    
    custom_settings = {
        'PLAYWRIGHT_BROWSER_TYPE': 'chromium',
        'PLAYWRIGHT_LAUNCH_OPTIONS': {
            'headless': os.getenv('HEADLESS_MODE', 'false').lower() == 'true',
        },
        'DOWNLOAD_HANDLERS': {
            'https': 'scrapy_playwright.handler.ScrapyPlaywrightDownloadHandler',
            'http': 'scrapy_playwright.handler.ScrapyPlaywrightDownloadHandler',
        },
        'TWISTED_REACTOR': 'twisted.internet.asyncioreactor.AsyncioSelectorReactor',
    }

    def start_requests(self):
        """
        Démarre le scraping avec Playwright pour gérer le JavaScript
        """
        yield scrapy.Request(
            url=self.start_urls[0],
            callback=self.parse_search,
            meta={
                'playwright': True,
                'playwright_page_methods': [
                    # Attendre que la page soit chargée
                    PageMethod('wait_for_selector', 'input.suchfeldAlles-publ', timeout=self.selector_timeout),
                ],
            },
            errback=self.errback_close_page,
        )

    async def parse_search(self, response):
        """
        Étape 1 : Effectuer la recherche avec le terme 'e'
        """
        page = response.meta['playwright_page']
        
        self.logger.info(f"Étape 1 : Remplissage du champ de recherche avec '{self.search_term}' et soumission")
        
        # Remplir le champ de recherche avec le terme de recherche
        await page.fill('input.suchfeldAlles-publ', self.search_term)
        
        # Attendre un petit moment pour que le formulaire soit prêt
        await page.wait_for_timeout(500)
        
        # Cliquer sur le bouton de recherche (icône fa-search)
        await page.click('i.fa-search')
        
        # Attendre que les résultats se chargent
        # On attend que le deuxième tbody dans la div GB2UA-DDDUB soit visible
        await page.wait_for_selector('div.GB2UA-DDDUB', timeout=self.selector_timeout)
        await page.wait_for_timeout(2000)  # Attente supplémentaire pour le chargement complet
        
        self.logger.info("Résultats de recherche chargés")
        
        # Parser les résultats
        yield scrapy.Request(
            url=page.url,
            callback=self.parse_results,
            meta={
                'playwright': True,
                'playwright_page': page,
                'playwright_include_page': True,
            },
            dont_filter=True,
        )

    async def parse_results(self, response):
        """
        Étape 2 : Parcourir le tableau des résultats et extraire les données
        """
        page = response.meta['playwright_page']
        
        self.logger.info(f"Étape 2 : Extraction des données de la page {self.current_page}")
        
        # Attendre que le tableau soit visible
        await page.wait_for_selector('div.GB2UA-DDDUB table.GB2UA-DDKIC', timeout=self.selector_timeout)
        
        # Récupérer le contenu HTML pour l'analyser avec Scrapy
        html_content = await page.content()
        new_response = scrapy.http.HtmlResponse(
            url=page.url,
            body=html_content.encode('utf-8'),
            encoding='utf-8'
        )
        
        # Trouver le deuxième tbody dans la div GB2UA-DDDUB
        container_div = new_response.css('div.GB2UA-DDDUB')
        
        if not container_div:
            self.logger.warning("Div GB2UA-DDDUB non trouvée")
            await page.close()
            return
        
        # Récupérer tous les tbody
        tbodies = container_div.css('tbody')
        
        if len(tbodies) < 2:
            self.logger.warning(f"Moins de 2 tbody trouvés ({len(tbodies)})")
            await page.close()
            return
        
        # Prendre le deuxième tbody
        second_tbody = tbodies[1]
        
        # Parcourir toutes les lignes (tr)
        rows = second_tbody.css('tr')
        self.logger.info(f"Nombre de lignes trouvées : {len(rows)}")
        
        for index, row in enumerate(rows):
            try:
                # Extraire la cellule avec cellindex="0" (dates)
                date_cell = row.css('td[cellindex="0"]::text').getall()
                date_cell_clean = [text.strip() for text in date_cell if text.strip()]
                
                date_publication = date_cell_clean[0] if len(date_cell_clean) > 0 else None
                date_arret = date_cell_clean[1] if len(date_cell_clean) > 1 else None
                
                # Extraire le lien PDF depuis la cellule cellindex="8"
                # On doit cliquer sur l'icône pour récupérer le lien PDF
                
                # Naviguer vers le bouton de téléchargement dans cette ligne
                download_button = await page.query_selector(
                    f'div.GB2UA-DDDUB table.GB2UA-DDKIC tbody:nth-of-type(2) tr:nth-of-type({index + 1}) td[cellindex="8"] i.fa-download'
                )
                
                pdf_url = None
                loadtable = None
                
                if download_button:
                    # Intercepter la requête réseau pour capturer le loadtable
                    async with page.expect_event('request') as request_info:
                        await download_button.click()
                        await page.wait_for_timeout(500)
                    
                    request = await request_info.value
                    request_url = request.url
                    
                    # Extraire le loadtable de l'URL
                    # L'URL devrait contenir un paramètre comme loadtable=...
                    if 'loadtable=' in request_url:
                        loadtable_match = re.search(r'loadtable=([^&]+)', request_url)
                        if loadtable_match:
                            loadtable = loadtable_match.group(1)
                            pdf_url = request_url
                    
                    # Fermer l'onglet/popup s'il s'est ouvert
                    pages = page.context.pages
                    if len(pages) > 1:
                        await pages[-1].close()
                
                # Créer l'item avec les données extraites
                item = PublicationItem()
                item['date_publication'] = date_publication
                item['date_arret'] = date_arret
                item['pdf_url'] = pdf_url
                item['loadtable'] = loadtable
                item['page_number'] = self.current_page
                
                self.logger.info(f"Ligne {index + 1}: Publication={date_publication}, Arrêt={date_arret}, PDF={pdf_url}")
                
                yield item
                
            except Exception as e:
                self.logger.error(f"Erreur lors du traitement de la ligne {index + 1}: {str(e)}")
                continue
        
        # Étape 3 : Vérifier s'il y a une page suivante et cliquer
        try:
            # Vérifier si on a atteint le nombre maximum de pages
            if self.max_pages > 0 and self.current_page >= self.max_pages:
                self.logger.info(f"Nombre maximum de pages atteint ({self.max_pages})")
                await page.close()
                return
            
            next_button = await page.query_selector('i.fa-angle-right')
            
            if next_button:
                self.logger.info("Étape 3 : Navigation vers la page suivante")
                
                # Vérifier si le bouton est actif (pas désactivé)
                parent = await next_button.evaluate_handle('el => el.parentElement')
                is_disabled = await parent.evaluate('el => el.classList.contains("disabled") || el.hasAttribute("disabled")')
                
                if not is_disabled:
                    # Incrémenter le compteur de pages
                    self.current_page += 1
                    
                    # Cliquer sur le bouton suivant
                    await next_button.click()
                    
                    # Attendre que la nouvelle page se charge
                    await page.wait_for_timeout(2000)
                    
                    # Récursion : parser la nouvelle page
                    yield scrapy.Request(
                        url=page.url,
                        callback=self.parse_results,
                        meta={
                            'playwright': True,
                            'playwright_page': page,
                            'playwright_include_page': True,
                        },
                        dont_filter=True,
                    )
                else:
                    self.logger.info("Bouton 'Page suivante' désactivé - fin de la pagination")
                    await page.close()
            else:
                self.logger.info("Aucun bouton 'Page suivante' trouvé - fin de la pagination")
                await page.close()
                
        except Exception as e:
            self.logger.error(f"Erreur lors de la navigation vers la page suivante: {str(e)}")
            await page.close()

    async def errback_close_page(self, failure):
        """
        Gestion des erreurs avec fermeture de la page Playwright
        """
        page = failure.request.meta.get('playwright_page')
        if page:
            await page.close()
        self.logger.error(f"Erreur: {failure}")
